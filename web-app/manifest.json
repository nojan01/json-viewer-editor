      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": ["developer", "productivity", "utilities"],
  "lang": "de-DE",
  "dir": "ltr",
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Datei öffnen",
      "short_name": "Öffnen",
      "description": "JSON-Datei zum Bearbeiten öffnen",
